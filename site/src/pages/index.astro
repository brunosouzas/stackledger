---
// Home page (catalogue-site, Home page, Home page chrome and Home links): a banner with the site title
// and text, a card per division with the view's counts and links, then the configured links.
// The links are the only URLs to other sites (site-security, No external requests): validated http(s)
// URLs from spec.site.home.links, opened in the same tab, with rel="noopener noreferrer".
import Base from '../layouts/Base.astro';
import { href, rootFor, site } from '../lib/site';

const root = rootFor(Astro.url.pathname);
const plural = (count: number, word: string) => `${count} ${count === 1 ? word : `${word}s`}`;
const skills = site.skills;
---

<Base title={site.title} current="home">
  <section class="home-banner">
    <div class="container">
      <h1>{site.title}</h1>
      <p class="lead">{site.home.text}</p>
      <img class="home-banner-art" src={href(root, 'home-banner.svg')} alt="" width="1200" height="420" />
    </div>
  </section>
  <section class="section">
    <div class="container">
    <div class="item-grid home-cards">
      <article class="card">
        <h2 class="card-title">Software</h2>
        <p>
          {plural(site.components.length, 'component')}, {plural(site.licences.length, 'licence')} and{' '}
          {plural(site.journeys.length, 'journey')}.
        </p>
        <ul class="home-links">
          <li><a href={href(root, 'map/')}>Map</a></li>
          <li><a href={href(root, 'software/')}>List</a></li>
          <li><a href={href(root, 'journeys/')}>Journeys</a></li>
          {'report' in site && <li><a href={href(root, 'reports/')}>Reports</a></li>}
        </ul>
      </article>
      {
        skills && (
          <article class="card">
            <h2 class="card-title">Skills</h2>
            <p>
              {plural(skills.counts.skills, 'skill')}, {plural(skills.counts.playbooks, 'playbook')}, {plural(skills.counts.agents, 'agent')} and{' '}
              {plural(skills.counts.rules, 'rule')}.
            </p>
            <ul class="home-links">
              <li><a href={href(root, 'skills/')}>List</a></li>
              <li><a href={href(root, 'skill-map/')}>Map</a></li>
              <li><a href={href(root, 'rules/')}>Rules</a></li>
            </ul>
          </article>
        )
      }
    </div>
    {
      site.home.links.length > 0 && (
        <>
          <h2>Links</h2>
          <ul class="home-external">
            {site.home.links.map((link: { title: string; url: string; description?: string; icon?: string }) => (
              <li>
                <a href={link.url} rel="noopener noreferrer">{link.icon && <><img class="link-icon themed-light" src={href(root, `link-icons/${link.icon}-light.svg`)} alt="" width="24" height="24" /><img class="link-icon themed-dark" src={href(root, `link-icons/${link.icon}-dark.svg`)} alt="" width="24" height="24" /></>}{link.title}</a>
                {link.description && <span class="muted"> · {link.description}</span>}
              </li>
            ))}
          </ul>
        </>
      )
    }
    </div>
  </section>
</Base>
