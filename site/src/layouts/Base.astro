---
// Shared page shell (catalogue-site, Layout): fixed CSP and noindex metas, header, main, footer.
// Structure from brunosouzas.com's Layout.astro (Astroplate theme, MIT, see LICENSE-astroplate).
// No inline code: the theme script is a bundled file, styles are imported files. The fonts come from
// Astro's Fonts API (src/site/build.ts): its <Font> components write inline <style> elements, which
// the build moves into _astro/fonts.css before the scan (catalogue-site, Font delivery). They come
// after the CSP meta, so the stylesheet link and the preloads are requested under the policy.
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/override.css';
import '../styles/base.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SubNav from '../components/SubNav.astro';
import { href, policy, rootFor, site, type Page } from '../lib/site';

interface Props {
  title: string;
  /** The page's entry in its division's sub-navigation; `exact` false on an item page, which marks none. */
  current: Page;
  exact?: boolean;
}
const { title, current, exact = true } = Astro.props;
// The home page belongs to no division: no sub-navigation, nothing marked in the header, and its
// title is the site title alone (catalogue-site, Home page chrome).
const home = current === 'home';
const division = home ? undefined : ['skills', 'skill-map', 'rules'].includes(current) ? 'skills' : 'software';
const root = rootFor(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={policy} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{home ? site.title : `${title} | ${site.title}`}</title>
    <Font cssVariable="--font-primary" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-secondary" preload={[{ weight: 700, style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
    <link rel="icon" type="image/svg+xml" href={href(root, 'favicon.svg')} />
    <script>
      import '../scripts/theme.ts';
    </script>
  </head>
  <body data-root={root}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header root={root} current={division} />
    {!home && <SubNav root={root} current={current} exact={exact} />}
    <main id="main">
      <slot />
    </main>
    <Footer root={root} />
  </body>
</html>
