---
// Sticky header from brunosouzas.com (Astroplate theme, MIT): brand, the divisions, theme switch.
// The brand opens the home page; the divisions are Software (the map) and, only when the build was given a skill set,
// Skills (skills-site, Skills pages); each division's pages are in its sub-navigation (SubNav.astro).
import ThemeSwitch from './ThemeSwitch.astro';
import { href, site } from '../lib/site';

interface Props {
  root: string;
  current?: 'software' | 'skills';
}
const { root, current } = Astro.props;
const links = [
  { key: 'software', title: 'Software', path: 'map/' },
  ...('skills' in site && site.skills ? [{ key: 'skills', title: 'Skills', path: 'skills/' }] : []),
];
---

<header class="header">
  <nav class="navbar container" aria-label="Main">
    <a class="navbar-brand" href={href(root, '')}><img class="brand-mark" src={href(root, 'favicon.svg')} alt="" width="28" height="28" />{site.title}</a>
    <ul class="navbar-nav">
      {
        links.map((link) => (
          <li>
            <a class="nav-link" href={href(root, link.path)} aria-current={link.key === current ? 'page' : undefined}>
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeSwitch />
  </nav>
</header>
