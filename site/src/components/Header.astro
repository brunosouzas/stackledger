---
// Sticky header from brunosouzas.com (Astroplate theme, MIT): brand, navigation, theme switch.
// Reports is linked only when the site's data has a report, which only the full site's has; Skills
// only when the build was given a skill set (skills-site, Skills pages).
import ThemeSwitch from './ThemeSwitch.astro';
import { href, site } from '../lib/site';

interface Props {
  root: string;
  current?: 'map' | 'software' | 'journeys' | 'reports' | 'skills' | undefined;
}
const { root, current } = Astro.props;
const links = [
  { key: 'map', title: 'Map', path: '' },
  { key: 'software', title: 'Software', path: 'software/' },
  { key: 'journeys', title: 'Journeys', path: 'journeys/' },
  ...('report' in site ? [{ key: 'reports', title: 'Reports', path: 'reports/' }] : []),
  ...('skills' in site && site.skills ? [{ key: 'skills', title: 'Skills', path: 'skills/' }] : []),
];
---

<header class="header">
  <nav class="navbar container" aria-label="Main">
    <a class="navbar-brand" href={href(root, '')}>{site.title}</a>
    <ul class="navbar-nav">
      {
        links.map((link) => (
          <li>
            <a class="nav-link" href={href(root, link.path)} aria-current={link.key === current ? 'page' : undefined}>
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeSwitch />
  </nav>
</header>
