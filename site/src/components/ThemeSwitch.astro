---
// Light/dark switch, after Astroplate's ThemeSwitcher (MIT). Hidden without JavaScript, where the
// page simply follows prefers-color-scheme; src/scripts/theme.ts shows it and remembers the choice.
---

<button type="button" class="theme-switch" role="switch" aria-checked="false" aria-label="Dark theme" data-theme-switch hidden>
  <span class="theme-switch-knob" aria-hidden="true">
    <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.5" fill="#ffffff"></circle>
      <path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"></path>
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16">
      <path fill="#040404" d="M8.2 2.2c1-.4 2 .6 1.6 1.5-1 3-.4 6.4 1.8 8.7a8.4 8.4 0 0 0 8.7 1.8c1-.3 2 .5 1.5 1.5v.1a10.3 10.3 0 0 1-9.4 6.2A10.3 10.3 0 0 1 3.2 6.7c1-2 2.9-3.5 4.9-4.4Z"></path>
    </svg>
  </span>
</button>
