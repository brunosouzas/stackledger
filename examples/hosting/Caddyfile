# stackledger behind Caddy and oauth2-proxy: a fictitious example (Northwind, example.org).
# The recipe, with the oauth2-proxy flags, is in docs/hosting.md.
#
# Every request is authenticated first, by oauth2-proxy at 127.0.0.1:4180. Only the groups that
# oauth2-proxy returns in X-Auth-Request-Groups count:
#   /full/*       finance
#   every other   staff or finance
#   anything else 403
# A request without a session is sent to the sign-in page. When oauth2-proxy cannot be reached,
# Caddy answers 502 and serves nothing (it fails closed).
#
# /srv/stackledger/publish holds only full/, staff/, _headers and robots.txt from stackledger build.
# Tested by test/integration/hosting-caddy.test.ts.

catalogue.example.org {
	root * /srv/stackledger/publish

	# oauth2-proxy's own pages: sign-in, callback, sign-out.
	handle /oauth2/* {
		reverse_proxy 127.0.0.1:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}

	handle {
		# route keeps the order below as written.
		route {
			# Drop any groups header the client sent: only oauth2-proxy's answer counts.
			request_header -X-Auth-Request-Groups

			forward_auth 127.0.0.1:4180 {
				uri /oauth2/auth
				copy_headers X-Auth-Request-Groups X-Auth-Request-Email

				@signed_out status 401
				handle_response @signed_out {
					redir * /oauth2/sign_in?rd={scheme}://{host}{uri} 302
				}
			}

			# oauth2-proxy sends the groups as a comma-separated list.
			@full_refused {
				path /full /full/*
				not header_regexp X-Auth-Request-Groups (^|,)\s*finance\s*(,|$)
			}
			respond @full_refused 403

			@refused not header_regexp X-Auth-Request-Groups (^|,)\s*(staff|finance)\s*(,|$)
			respond @refused 403

			# The host has no page at /.
			redir / /staff/ 302

			# The same headers stackledger writes into _headers, which Caddy does not read.
			header {
				Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
				X-Content-Type-Options nosniff
				Referrer-Policy no-referrer
				X-Robots-Tag "noindex, nofollow"
				Permissions-Policy "camera=(), microphone=(), geolocation=()"
			}
			@calendar path *.ics
			header @calendar Content-Type "text/calendar; charset=utf-8"

			file_server
		}
	}
}
